# Copy to .env.local and fill with your Supabase project values (Settings → API).
# Never commit .env.local or any file containing real keys.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# DO/SDAO welfare "Create Account" uses Edge Function create-staff-account (service role on server only).
# Deploy to the SAME project as VITE_SUPABASE_URL (run from repo root, not .cursor/):
#   npx supabase link --project-ref YOUR_PROJECT_REF
#   Use ONLY the id (e.g. lgqfkuvswbvqljixashq), NOT https://....supabase.co
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...   # if not auto-injected
#   npx supabase functions deploy create-staff-account
#
# Local stack (`supabase start`): use local API URL for both URL and functions, e.g.
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<anon key from `supabase status`>
# Then run (in another terminal): supabase functions serve
# Or omit the line below — the client defaults to {SUPABASE_URL}/functions/v1
# VITE_SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
#
# Welcome email after staff create (Edge Function secrets, not VITE_):
#   npx supabase secrets set RESEND_API_KEY=re_...
#   npx supabase secrets set STAFF_WELCOME_EMAIL_FROM="CampusCare <noreply@yourdomain.com>"
# See supabase/functions/create-staff-account/README.md
