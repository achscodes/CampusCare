# Copy to .env.local and fill with your Supabase project values (Settings → API).
# Never commit .env.local or any file containing real keys.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# DO/SDAO welfare "Create Account" uses Edge Function create-staff-account (service role on server only).
# From repo root: supabase link --project-ref YOUR_PROJECT_REF
# Then: supabase functions deploy create-staff-account
